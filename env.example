# Общие настройки
PROJECT_NAME=esso
JAVA_VERSION=21

# Настройки портов для внешнего доступа
COMMON_PORT=8080
ESP_PORT=8081
INTEGRATION_PORT=8082
UBK_PORT=8083

# Настройки серверов (внутренние порты)
COMMON_SERVER_PORT=8080
ESP_SERVER_PORT=8081
INTEGRATION_SERVER_PORT=8082
UBK_SERVER_PORT=8083

# Настройки базы данных Common
# Замените localhost на IP адрес вашего сервера БД
COMMON_DB_URL=jdbc:postgresql://localhost:5432/common_db
COMMON_DB_USER=common_user
COMMON_DB_PASS=common_password

# Настройки базы данных ESP
ESP_DB_URL=jdbc:postgresql://localhost:5432/esp_db
ESP_DB_USER=esp_user
ESP_DB_PASS=esp_password

# Настройки базы данных Integration
INTEGRATION_DB_URL=jdbc:postgresql://localhost:5432/integration_db
INTEGRATION_DB_USER=integration_user
INTEGRATION_DB_PASS=integration_password

# Настройки базы данных UBK
UBK_DB_URL=jdbc:postgresql://localhost:5432/ubk_db
UBK_DB_USER=ubk_user
UBK_DB_PASS=ubk_password

# Настройки Integration API
INTEGRATION_API_BASE_URL=http://localhost:8082
INTEGRATION_API_X_API_KEY=your-api-key
INTEGRATION_API_USER_NAME=integration_user
INTEGRATION_API_ROLE_NAME=integration_role

# Примеры для разных окружений:

# Для Docker Compose (если БД в контейнерах):
# COMMON_DB_URL=jdbc:postgresql://common-db:5432/common_db
# ESP_DB_URL=jdbc:postgresql://esp-db:5432/esp_db
# INTEGRATION_DB_URL=jdbc:postgresql://integration-db:5432/integration_db
# UBK_DB_URL=jdbc:postgresql://ubk-db:5432/ubk_db

# Для внешнего сервера БД:
# COMMON_DB_URL=jdbc:postgresql://your-db-server:5432/common_db
# ESP_DB_URL=jdbc:postgresql://your-db-server:5432/esp_db
# INTEGRATION_DB_URL=jdbc:postgresql://your-db-server:5432/integration_db
# UBK_DB_URL=jdbc:postgresql://your-db-server:5432/ubk_db
